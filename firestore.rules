rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsVehicle(vehicleId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && exists(userPath)
        && (
          get(userPath).data.vehicleId == vehicleId
          || exists(
            /databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(vehicleId)
          )
        );
    }

    function userOwnsVehicle(uid, vehicleId) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let membershipPath = /databases/$(database)/documents/users/$(uid)/vehicles/$(vehicleId);
      let vehiclePath = /databases/$(database)/documents/vehicles/$(vehicleId);
      return ownsUser(uid)
        && exists(userPath)
        && (
          get(userPath).data.vehicleId == vehicleId
          || (
            exists(membershipPath)
            && get(membershipPath).data.uid == uid
            && get(membershipPath).data.vehicleId == vehicleId
          )
        )
        && exists(vehiclePath)
        && get(vehiclePath).data.isActive == true;
    }

    match /users/{uid} {
      allow read: if ownsUser(uid);
      allow create: if false;
      allow update: if ownsUser(uid)
        && request.resource.data.uid == resource.data.uid
        && (
          (
            request.resource.data.vehicleId == resource.data.vehicleId
            && request.resource.data.vehicleRegistrationNumber
              == resource.data.vehicleRegistrationNumber
          )
          || (
            request.resource.data.vehicleId is string
            && exists(
              /databases/$(database)/documents/users/$(uid)/vehicles/$(request.resource.data.vehicleId)
            )
            && exists(
              /databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)
            )
            && get(
              /databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)
            ).data.isActive == true
            && request.resource.data.vehicleRegistrationNumber
              == get(
                /databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)
              ).data.registrationNumber
          )
        )
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name', 'email', 'phone', 'city', 'dateOfBirth',
            'profileImageUrl', 'preferredDrivingMode',
            'preferredChargingMode', 'notificationPreference',
            'distanceUnit', 'notificationsEnabled', 'locationEnabled',
            'preferences', 'vehicleId', 'vehicleRegistrationNumber',
            'updatedAt'
          ])
        && (
          !request.resource.data.keys().hasAny(['city'])
          || request.resource.data.city is string
        )
        && (
          !request.resource.data.keys().hasAny(['dateOfBirth'])
          || request.resource.data.dateOfBirth is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(['profileImageUrl'])
          || request.resource.data.profileImageUrl is string
        )
        && (
          !request.resource.data.keys().hasAny(['preferredDrivingMode'])
          || request.resource.data.preferredDrivingMode is string
        )
        && (
          !request.resource.data.keys().hasAny(['preferredChargingMode'])
          || request.resource.data.preferredChargingMode is string
        )
        && (
          !request.resource.data.keys().hasAny(['notificationPreference'])
          || request.resource.data.notificationPreference is string
        )
        && (
          !request.resource.data.keys().hasAny(['distanceUnit'])
          || request.resource.data.distanceUnit is string
        )
        && (
          !request.resource.data.keys().hasAny(['notificationsEnabled'])
          || request.resource.data.notificationsEnabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['locationEnabled'])
          || request.resource.data.locationEnabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['preferences'])
          || request.resource.data.preferences is map
        );
      allow delete: if false;

      match /vehicles/{vehicleId} {
        allow read: if ownsUser(uid);
        allow create, update, delete: if false;

        match /chargingCard/{cardId} {
          allow read: if userOwnsVehicle(uid, vehicleId)
            && cardId == 'current'
            && (
              !exists(
                /databases/$(database)/documents/users/$(uid)/vehicles/$(vehicleId)/chargingCard/current
              )
              || resource.data.vehicleId == vehicleId
            );
          allow create: if userOwnsVehicle(uid, vehicleId)
            && cardId == 'current'
            && request.resource.data.keys().hasAll([
              'cardId', 'cardType', 'maskedCardNumber', 'cardHolderName',
              'vehicleId', 'vehicleModel', 'vehicleRegistrationNumber',
              'vehicleVin', 'expiryDate', 'balance', 'currency', 'status',
              'registeredAt', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'cardId', 'cardType', 'maskedCardNumber', 'cardHolderName',
              'vehicleId', 'vehicleModel', 'vehicleRegistrationNumber',
              'vehicleVin', 'expiryDate', 'balance', 'currency', 'status',
              'registeredAt', 'updatedAt'
            ])
            && request.resource.data.cardId == cardId
            && request.resource.data.cardType is string
            && request.resource.data.cardType.size() > 0
            && request.resource.data.maskedCardNumber is string
            && request.resource.data.maskedCardNumber.matches(
              '^XXXX XXXX XXXX [A-Za-z0-9]{4}$'
            )
            && request.resource.data.cardHolderName is string
            && request.resource.data.cardHolderName.size() > 0
            && request.resource.data.vehicleId == vehicleId
            && request.resource.data.vehicleModel
              == get(
                /databases/$(database)/documents/vehicles/$(vehicleId)
              ).data.model
            && request.resource.data.vehicleRegistrationNumber
              == get(
                /databases/$(database)/documents/vehicles/$(vehicleId)
              ).data.registrationNumber
            && request.resource.data.vehicleVin
              == get(
                /databases/$(database)/documents/vehicles/$(vehicleId)
              ).data.vin
            && request.resource.data.balance == 0
            && request.resource.data.currency is string
            && request.resource.data.currency.size() == 3
            && request.resource.data.status == 'ACTIVE'
            && request.resource.data.expiryDate is timestamp
            && request.resource.data.registeredAt is timestamp
            && request.resource.data.updatedAt is timestamp;
          allow update: if userOwnsVehicle(uid, vehicleId)
            && cardId == 'current'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'cardType', 'maskedCardNumber', 'cardHolderName',
                'expiryDate', 'vehicleModel', 'vehicleRegistrationNumber',
                'vehicleVin', 'updatedAt', 'cardNumber', 'cvv', 'pin',
                'paymentPassword'
              ])
            && request.resource.data.cardId == resource.data.cardId
            && request.resource.data.vehicleId == vehicleId
            && request.resource.data.vehicleModel
              == get(
                /databases/$(database)/documents/vehicles/$(vehicleId)
              ).data.model
            && request.resource.data.vehicleRegistrationNumber
              == get(
                /databases/$(database)/documents/vehicles/$(vehicleId)
              ).data.registrationNumber
            && request.resource.data.vehicleVin
              == get(
                /databases/$(database)/documents/vehicles/$(vehicleId)
              ).data.vin
            && request.resource.data.balance == resource.data.balance
            && request.resource.data.status == resource.data.status
            && request.resource.data.currency == resource.data.currency
            && request.resource.data.registeredAt == resource.data.registeredAt
            && request.resource.data.cardType is string
            && request.resource.data.cardType.size() > 0
            && request.resource.data.maskedCardNumber is string
            && request.resource.data.maskedCardNumber.matches(
              '^XXXX XXXX XXXX [A-Za-z0-9]{4}$'
            )
            && request.resource.data.cardHolderName is string
            && request.resource.data.cardHolderName.size() > 0
            && request.resource.data.expiryDate is timestamp
            && request.resource.data.updatedAt is timestamp
            && !request.resource.data.keys().hasAny([
              'cardNumber', 'cvv', 'pin', 'paymentPassword'
            ]);
          allow delete: if false;

          match /transactions/{transactionId} {
            allow read: if userOwnsVehicle(uid, vehicleId)
              && cardId == 'current'
              && exists(
                /databases/$(database)/documents/users/$(uid)/vehicles/$(vehicleId)/chargingCard/current
              );
            allow write: if false;
          }
        }
      }

      match /chargingCard/{cardId} {
        allow read, write: if false;

        match /transactions/{transactionId} {
          allow read, write: if false;
        }
      }
    }

    match /vehicles/{vehicleId} {
      allow read: if ownsVehicle(vehicleId);
      allow create, delete: if false;
      allow update: if ownsVehicle(vehicleId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'maximumRangeKm',
            'batteryCapacityKwh',
            'connectorType',
            'updatedAt'
          ])
        && request.resource.data.maximumRangeKm is number
        && request.resource.data.maximumRangeKm > 0
        && (
          !request.resource.data.keys().hasAny(['batteryCapacityKwh'])
          || (
            request.resource.data.batteryCapacityKwh is number
            && request.resource.data.batteryCapacityKwh > 0
          )
        )
        && request.resource.data.connectorType is string
        && request.resource.data.updatedAt is timestamp;

      match /telemetry/{telemetryId} {
        allow read, create, update: if ownsVehicle(vehicleId);
        allow delete: if false;
      }

      match /maintenance/{recordId} {
        allow read: if ownsVehicle(vehicleId);
        allow create: if ownsVehicle(vehicleId)
          && request.resource.data.vehicleId == vehicleId
          && request.resource.data.serviceType is string
          && request.resource.data.serviceType.size() > 0
          && request.resource.data.category is string
          && request.resource.data.serviceDate is timestamp
          && (
            !request.resource.data.keys().hasAny(['nextServiceDate'])
            || request.resource.data.nextServiceDate == null
            || request.resource.data.nextServiceDate is timestamp
          )
          && (
            !request.resource.data.keys().hasAny(['odometerKm'])
            || request.resource.data.odometerKm == null
            || (
              request.resource.data.odometerKm is number
              && request.resource.data.odometerKm >= 0
            )
          )
          && (
            !request.resource.data.keys().hasAny(['cost'])
            || request.resource.data.cost == null
            || (
              request.resource.data.cost is number
              && request.resource.data.cost >= 0
            )
          )
          && request.resource.data.status == 'Completed'
          && request.resource.data.source == 'user_entered'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly([
            'vehicleId', 'serviceType', 'category', 'serviceDate',
            'nextServiceDate', 'odometerKm', 'cost', 'serviceCenter',
            'notes', 'status', 'source', 'createdAt', 'updatedAt'
          ]);
        allow update, delete: if false;
      }

      match /chargingCard/{cardId} {
        allow read, write: if false;

        match /transactions/{transactionId} {
          allow read, write: if false;
        }
      }

    }

    match /vehicleClaims/{vehicleId} {
      allow read, write: if false;
    }

    match /chargingSessions/{sessionId} {
      allow read, write: if false;
    }
  }
}